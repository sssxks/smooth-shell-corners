{
  "name": "smooth-shell-corners",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.mjs",
    "test:gjs": "gjs -m tests/unit/native-radius.test.js && gjs -m tests/unit/preferences.test.js",
    "test:all": "npm run test && npm run test:gjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@girs/gjs": "4.7.0",
    "@girs/gnome-shell": "50.0.4",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
